diff --git a/src/crypto/word32.s b/src/crypto/word32.s
index 3225948..29432b4 100644
--- a/src/crypto/word32.s
+++ b/src/crypto/word32.s
@@ -12,26 +12,45 @@
 
 .include "constants.inc"
 
+.ifdef WORD32_ALL
 .export add32
+.endif
 .export add32_to_dst
+.ifdef WORD32_ALL
 .export xor32
+.endif
 .export xor32_in_place
 .export rotr32_16
+.ifdef WORD32_ALL
 .export rotr32_8
+.endif
+.ifdef WORD32_ALL
 .export rotr32_12
+.endif
+.ifdef WORD32_ALL
 .export rotr32_4
+.endif
+.ifdef WORD32_ALL
 .export rotr32_7
+.endif
+.ifdef WORD32_ALL
 .export rotl32_1
+.endif
 .export rotl32_8
 .export rotl32_4
 .export rotl32_12
 .export rotr32_1
 .export rotl32_7
+.ifdef WORD32_ALL
 .export copy32
+.endif
+.ifdef WORD32_ALL
 .export zero32
+.endif
 
 .segment "CRYPTO_CODE"
 
+.ifdef WORD32_ALL                       ; S2 spike: no caller in any build
 ; =============================================================================
 ; add32 - 32-bit addition: (w32_dst) = (w32_src1) + (w32_src2)
 ; Preserves: X
@@ -56,6 +75,7 @@ add32:
         adc (w32_src2),y
         sta (w32_dst),y
         rts
+.endif
 
 ; =============================================================================
 ; add32_to_dst - 32-bit add-in-place: (w32_dst) += (w32_src1)
@@ -82,6 +102,7 @@ add32_to_dst:
         sta (w32_dst),y
         rts
 
+.ifdef WORD32_ALL                       ; S2 spike: no caller in any build
 ; =============================================================================
 ; xor32 - 32-bit XOR: (w32_dst) = (w32_src1) ^ (w32_src2)
 ; Preserves: X
@@ -105,6 +126,7 @@ xor32:
         eor (w32_src2),y
         sta (w32_dst),y
         rts
+.endif
 
 ; =============================================================================
 ; xor32_in_place - 32-bit XOR in place: (w32_dst) ^= (w32_src1)
@@ -160,6 +182,7 @@ rotr32_16:
         sta (w32_dst),y        ; pos3 = b1
         rts
 
+.ifdef WORD32_ALL                       ; S2 spike: no caller in any build
 ; =============================================================================
 ; rotr32_8 - Rotate right 32 bits by 8 (byte rotate right)
 ; Little-endian: [b0 b1 b2 b3] >>> 8 = [b1 b2 b3 b0]
@@ -321,6 +344,7 @@ rotl32_1:
         sta (w32_dst),y
 :
         rts
+.endif
 
 ; =============================================================================
 ; rotl32_8 - Rotate left 32 bits by 8 (byte rotate left)
@@ -491,6 +515,7 @@ rotl32_7:
         jsr rotl32_8
         jmp rotr32_1           ; tail call
 
+.ifdef WORD32_ALL                       ; S2 spike: no caller in any build
 ; =============================================================================
 ; copy32 - Copy 4 bytes: (w32_dst) = (w32_src1)
 ; Preserves: X
@@ -527,3 +552,4 @@ zero32:
         iny
         sta (w32_dst),y
         rts
+.endif
diff --git a/src/der_decode.s b/src/der_decode.s
index c431c3f..ffc8d7e 100644
--- a/src/der_decode.s
+++ b/src/der_decode.s
@@ -19,6 +19,7 @@
 .export der_read_length
 .export der_skip
 .export der_skip_tlv
+.ifdef X509_PARSE_CERT                  ; S2 spike: off the live path
 .export der_match_oid
 .export x509_parse_cert
 
@@ -30,7 +31,6 @@
 .export oid_sha384_ecdsa
 
 ; --- Public exports: BSS data ---
-.export der_len
 .export cert_tbs_ptr
 .export cert_tbs_len
 .export cert_pubkey
@@ -39,6 +39,8 @@
 .export cert_sig_s
 .export cert_sig_len
 .export cert_curve_id
+.endif
+.export der_len
 .export cert_buf
 .export cert_buf_len
 
@@ -151,6 +153,7 @@ der_skip_tlv:
         jsr der_read_length
         jmp der_skip            ; tail call
 
+.ifdef X509_PARSE_CERT
 ; =============================================================================
 ; der_match_oid - Compare bytes at (zp_ptr) against a known OID
 ; Input: A/X = pointer to expected OID bytes (lo/hi), Y = OID length
@@ -544,7 +547,9 @@ x509_parse_cert:
 ; --- Local temporaries (not ZP, just inline storage within x509_parse_cert) ---
 @tbs_end:        .word 0
 @algid_end:      .word 0
+.endif
 
+.ifdef X509_PARSE_CERT
 ; =============================================================================
 .segment "RODATA"
 ; =============================================================================
@@ -560,12 +565,16 @@ oid_sha256_ecdsa:                       ; 1.2.840.10045.4.3.2 (ecdsa-with-SHA256
         .byte $2a,$86,$48,$ce,$3d,$04,$03,$02
 oid_sha384_ecdsa:                       ; 1.2.840.10045.4.3.3 (ecdsa-with-SHA384)
         .byte $2a,$86,$48,$ce,$3d,$04,$03,$03
+.endif
 
 ; =============================================================================
 .segment "BSS"
 ; =============================================================================
 
 der_len:           .res 2               ; last parsed length (16-bit LE)
+; ip65 keeps the dead BSS: its TABLES_BSS is not start-pinned, so
+; shrinking BSS moves sqtab off $BC00 (post-link assert).
+.if .defined(X509_PARSE_CERT) .or .defined(BACKEND_IP65)
 cert_tbs_ptr:      .res 2               ; pointer to TBS bytes in cert_buf
 cert_tbs_len:      .res 2               ; length of TBS (tag + length + value)
 cert_pubkey:       .res 96              ; public key Qx||Qy (max 48+48 for P-384)
@@ -574,6 +583,7 @@ cert_sig_r:        .res 48              ; signature r component (max 48 for P-38
 cert_sig_s:        .res 48              ; signature s component (max 48 for P-384)
 cert_sig_len:      .res 1               ; 32 (P-256) or 48 (P-384)
 cert_curve_id:     .res 1               ; 0=P-256, 1=P-384
+.endif
 ; ip65 refit: cert_buf gets its own segment (was BSS_TAIL alongside
 ; src/data.s::tls_rec_buf) so the ip65 cfg can pin it at $A000 and
 ; time-share the RAM with LIB_NISTCURVES_P256_BSS (verify-time scratch).
