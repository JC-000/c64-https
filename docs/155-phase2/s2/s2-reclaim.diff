diff --git a/Makefile b/Makefile
index 49c11d6..d5b43a2 100644
--- a/Makefile
+++ b/Makefile
@@ -342,6 +342,19 @@ CA65FLAGS += -D ENABLE_P384_VERIFY=1
 else
 CRYPTO_SRCS_EFFECTIVE := $(filter-out $(P384_SRCS),$(CRYPTO_SRCS_EFFECTIVE))
 endif
+# S2 spike: x509_parse_cert is off the live path; test_x509.py builds it in.
+ifeq ($(X509_PARSE_CERT),1)
+CA65FLAGS += -D X509_PARSE_CERT=1
+endif
+ifeq ($(WORD32_ALL),1)
+CA65FLAGS += -D WORD32_ALL=1
+endif
+# S2 spike: crypto_swap.o has no importer unless the P-384 arm or the
+# P-384 overlay embed is on (ld65 map Imports list, all UCI profiles).
+ifneq ($(ENABLE_P384_VERIFY)$(S2_KEEP_CRYPTO_SWAP)$(filter 1,$(USE_OVERLAY_P384_EMBED)),)
+else
+CRYPTO_SHARED_SRCS := $(filter-out src/crypto/shared/crypto_swap.s,$(CRYPTO_SHARED_SRCS))
+endif
 
 # Per-backend source + object selection.
 ifeq ($(BACKEND),ip65)
